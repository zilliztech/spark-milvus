# Restore missing provider edges in the reviewed shared dependency recipes.
# This hook changes CMake targets after their upstream declarations, without
# editing source snapshots or relying on a parent's process-wide symbol scope.
# Recipe identities and target/source shapes must be reviewed together.
# Only shared libraries need these corrections. Static build tools retain
# upstream link declarations and descriptor ownership in their parent archives.
get_property(milvus_dependency_try_compile GLOBAL PROPERTY IN_TRY_COMPILE)
if(milvus_dependency_try_compile)
  return()
endif()
include_guard(GLOBAL)

if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "Dependency linkage corrections are only reviewed for Linux")
endif()
if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  message(FATAL_ERROR "Dependency linkage hook must run in the dependency's root project")
endif()

function(milvus_dependency_library_kind target output)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Reviewed dependency target is missing: ${target}")
  endif()
  get_target_property(kind "${target}" TYPE)
  if(NOT kind STREQUAL "SHARED_LIBRARY" AND NOT kind STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "Reviewed dependency target must be a shared or static library: ${target}")
  endif()
  set("${output}" "${kind}" PARENT_SCOPE)
endfunction()

function(milvus_link_opentelemetry_provider)
  milvus_dependency_library_kind(opentelemetry_proto_grpc linkage_kind)
  if(NOT TARGET opentelemetry_proto OR NOT TARGET gRPC::grpc++)
    message(FATAL_ERROR "Reviewed OpenTelemetry proto/gRPC targets are missing")
  endif()
  milvus_dependency_library_kind(opentelemetry_proto proto_kind)
  if(NOT proto_kind STREQUAL linkage_kind)
    message(FATAL_ERROR "Reviewed OpenTelemetry library kinds are mixed")
  endif()
  get_target_property(providers opentelemetry_proto_grpc LINK_LIBRARIES)
  if(NOT "opentelemetry_proto" IN_LIST providers)
    message(FATAL_ERROR "Reviewed OpenTelemetry proto link declarations changed")
  endif()
  if(linkage_kind STREQUAL "STATIC_LIBRARY")
    return()
  endif()
  # Conan's gRPC::grpc++ is an INTERFACE wrapper around its shared library.
  # Upstream's TYPE == SHARED_LIBRARY check therefore misses this provider.
  if(NOT "gRPC::grpc++" IN_LIST providers)
    target_link_libraries(opentelemetry_proto_grpc PUBLIC gRPC::grpc++)
  endif()
endfunction()

function(milvus_move_upb_descriptor_provider)
  set(descriptor "src/core/ext/upb-gen/google/protobuf/descriptor.upb_minitable.c")
  if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${descriptor}")
    message(FATAL_ERROR "Reviewed gRPC descriptor source is missing")
  endif()
  milvus_dependency_library_kind(grpc linkage_kind)
  foreach(target IN ITEMS grpc_unsecure upb_mini_descriptor_lib upb_json_lib upb_textformat_lib)
    milvus_dependency_library_kind("${target}" kind)
    if(NOT kind STREQUAL linkage_kind)
      message(FATAL_ERROR "Reviewed gRPC/upb library kinds are mixed: ${target}")
    endif()
  endforeach()
  foreach(target IN ITEMS grpc grpc_unsecure)
    get_target_property(sources "${target}" SOURCES)
    set(without_descriptor "${sources}")
    list(REMOVE_ITEM without_descriptor "${descriptor}")
    list(LENGTH sources original_count)
    list(LENGTH without_descriptor remaining_count)
    math(EXPR expected_count "${remaining_count} + 1")
    if(NOT original_count EQUAL expected_count)
      message(FATAL_ERROR "Reviewed gRPC descriptor must occur once in ${target} sources")
    endif()
  endforeach()
  get_target_property(provider_sources upb_mini_descriptor_lib SOURCES)
  if("${descriptor}" IN_LIST provider_sources)
    message(FATAL_ERROR "Reviewed upb descriptor ownership has already changed")
  endif()
  foreach(target IN ITEMS upb_json_lib upb_textformat_lib grpc_unsecure)
    get_target_property(providers "${target}" LINK_LIBRARIES)
    if(NOT "upb_mini_descriptor_lib" IN_LIST providers)
      message(FATAL_ERROR "Reviewed upb provider edge is missing from ${target}")
    endif()
  endforeach()
  get_target_property(grpc_providers grpc LINK_LIBRARIES)
  if(NOT "upb_json_lib" IN_LIST grpc_providers OR NOT "upb_textformat_lib" IN_LIST grpc_providers)
    message(FATAL_ERROR "Reviewed gRPC upb provider edges changed")
  endif()
  if(linkage_kind STREQUAL "STATIC_LIBRARY")
    return()
  endif()
  # Both upb consumers already link this lower-level library. Keep exactly one
  # descriptor definition, and avoid a circular link from upb back to gRPC.
  foreach(target IN ITEMS grpc grpc_unsecure)
    get_target_property(sources "${target}" SOURCES)
    list(REMOVE_ITEM sources "${descriptor}")
    set_property(TARGET "${target}" PROPERTY SOURCES "${sources}")
  endforeach()
  target_sources(upb_mini_descriptor_lib PRIVATE "${descriptor}")
endfunction()

if(PROJECT_NAME STREQUAL "opentelemetry-cpp"
    AND MILVUS_DEPENDENCY_RECIPE STREQUAL "opentelemetry-cpp/1.23.0@milvus/dev#11bc565ec6e82910ae8f7471da756720")
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL milvus_link_opentelemetry_provider)
elseif(PROJECT_NAME STREQUAL "grpc"
    AND MILVUS_DEPENDENCY_RECIPE STREQUAL "grpc/1.67.1@milvus/dev#efeaa484b59bffaa579004d5e82ec4fd")
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL milvus_move_upb_descriptor_provider)
else()
  message(FATAL_ERROR "Unreviewed dependency linkage recipe/project: ${MILVUS_DEPENDENCY_RECIPE} / ${PROJECT_NAME}")
endif()
