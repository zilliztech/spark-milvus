[settings]
os=Macos
arch=armv8
compiler=apple-clang
compiler.version=21
compiler.libcxx=libc++
compiler.cppstd=20
build_type=Release

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
# aws-sdk-cpp's RequestCompression calls zlib but the recipe declares no zlib
# dependency. ELF resolves the symbols through another shared library on the
# link line; Mach-O's two-level namespace requires a declared provider, so the
# system zlib -- which the bundle never carries -- is named here. Remove this
# when the recipe declares and links zlib itself.
aws-sdk-cpp/*:tools.build:sharedlinkflags+=["-lz"]

[platform_tool_requires]
cmake/3.31.10

