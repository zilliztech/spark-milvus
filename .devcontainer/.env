# Variables docker compose substitutes into docker-compose.yml.
# Service image tags. The dev image itself is built locally from the root
# Dockerfile's `dev` stage and has no tag here.
MILVUS_IMAGE=milvusdb/milvus:v3.0.1
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-05-28T17-19-04Z
# Host uid and gid the container user takes, so files written into the
# bind-mounted checkout belong to you. scripts/devcontainer.sh sets them from
# `id`; an IDE launching compose directly uses these defaults unless DEV_UID
# and DEV_GID are exported in the shell that started it.
DEV_UID=1000
DEV_GID=1000
