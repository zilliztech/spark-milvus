{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "runner",
    "job",
    "pod",
    "podSecurityContext",
    "containerSecurityContext",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "readOptions"
  ],
  "properties": {
    "nameOverride": {
      "$ref": "#/$defs/optionalKubernetesLabel"
    },
    "fullnameOverride": {
      "$ref": "#/$defs/optionalKubernetesLabel"
    },
    "runId": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
    },
    "ownershipToken": {
      "type": "string",
      "pattern": "^$|^[0-9]+-[0-9]+-[0-9]+-[0-9]+$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy",
        "pullSecrets"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/kubernetesName"
              }
            }
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "annotations"
      ],
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 60
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotations",
        "serviceAccountName",
        "automountServiceAccountToken",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "serviceAccountName": {
          "$ref": "#/$defs/optionalKubernetesName"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "readOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "$ref": "#/$defs/kubernetesName"
        }
      }
    }
  },
  "$defs": {
    "optionalKubernetesLabel": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "maxLength": 63
    },
    "optionalKubernetesName": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "maxLength": 253
    },
    "kubernetesName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "maxLength": 253
    }
  }
}
